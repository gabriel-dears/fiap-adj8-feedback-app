# ===============================
# DATABASE
# ===============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=feedback_db
DB_USERNAME=fiap_user
DB_PASSWORD=pass
DB_DRIVER_CLASS=org.postgresql.Driver

# ===============================
# GCP
# ===============================
GCP_PROJECT_ID=fiap-adj8-feedback-platform
GCP_SQL_INSTANCE_CONNECTION_NAME=fiap-adj8-feedback-platform:us-central1:feedback-db-instance
GCP_SQL_DATABASE_NAME=feedback_db
GCP_PUBSUB_ENABLED=true

# ===============================
# JPA / HIBERNATE
# ===============================
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ===============================
# FLYWAY
# ===============================
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_LOCATIONS=classpath:db/migration

# ===============================
# SERVER
# ===============================
SERVER_PORT=8080
